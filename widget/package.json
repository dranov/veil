{
  "name": "@veil/widgets",
  "version": "0.1.0",
  "description": "Veil widget components for Lean infoview",
  "type": "module",
  "scripts": {
    "watch": "node scripts/watch.mjs --production",
    "watch-dev": "node scripts/watch.mjs",
    "build": "tsc && rollup --environment NODE_ENV:production --config",
    "build-dev": "tsc && rollup --config",
    "clean": "rm -rf dist/",
    "test:watch": "node --test test/watch.test.mjs"
  },
  "dependencies": {
    "@leanprover/infoview": "~0.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vscode-languageserver-protocol": "^3.17.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^0.4.0",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "rollup": "^4.17.2",
    "tslib": "^2.5.0",
    "typescript": "^5.0.3"
  }
}
